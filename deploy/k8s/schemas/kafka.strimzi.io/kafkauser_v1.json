{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"enum": ["kafka.strimzi.io/v1"]},
    "kind": {"enum": ["KafkaUser"]},
    "metadata": {"type": "object", "required": ["name", "namespace"]},
    "spec": {
      "type": "object",
      "required": ["authentication", "authorization"],
      "properties": {
        "authentication": {
          "type": "object",
          "required": ["type"],
          "properties": {"type": {"enum": ["tls"]}}
        },
        "authorization": {
          "type": "object",
          "required": ["type", "acls"],
          "properties": {
            "type": {"enum": ["simple"]},
            "acls": {"type": "array", "minItems": 1}
          }
        }
      }
    }
  }
}
