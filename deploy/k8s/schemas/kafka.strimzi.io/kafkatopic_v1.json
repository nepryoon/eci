{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"enum": ["kafka.strimzi.io/v1"]},
    "kind": {"enum": ["KafkaTopic"]},
    "metadata": {"type": "object", "required": ["name", "namespace"]},
    "spec": {
      "type": "object",
      "required": ["topicName", "partitions", "replicas"],
      "properties": {
        "topicName": {"type": "string", "minLength": 1},
        "partitions": {"type": "integer", "minimum": 1},
        "replicas": {"type": "integer", "minimum": 1},
        "config": {"type": "object"}
      }
    }
  }
}
