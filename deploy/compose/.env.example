# Required by the Keycloak development service. Keep real values only in
# deploy/compose/.env (ignored by Git via the repository-wide .env rule).
KC_BOOTSTRAP_ADMIN_PASSWORD=
ECI_DEV_USER_PASSWORD=

# Required by the ingestion CLI. These labels are persisted with every node,
# chunk and outbox event; there are intentionally no security defaults.
ECI_TENANT_ID=
ECI_REPOSITORY=
ECI_ACL_GROUP=
