{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eci.internal/contracts/ingestion-file-command.json",
  "title": "IngestionFileCommand",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "commit_sha", "path"],
  "properties": {
    "schema_version": {"const": "1"},
    "operation": {"type": "string", "enum": ["UPSERT", "DELETE"]},
    "command_id": {"type": "string", "format": "uuid"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Repository-relative UTF-8 path; length is Unicode code points per JSON Schema 2020-12"
    },
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777216
    }
  },
  "oneOf": [
    {
      "properties": {"operation": {"const": "UPSERT"}},
      "required": ["source_sha256", "source_size_bytes"]
    },
    {
      "properties": {
        "operation": {"const": "DELETE"},
        "source_sha256": false,
        "source_size_bytes": false
      },
      "required": ["operation"]
    }
  ]
}
